{
  "packages": {
    "engine": {
      "component": "engine",
      "package-name": "lelu-engine",
      "changelog-path": "CHANGELOG.md",
      "release-type": "go"
    },
    "sdk/typescript": {
      "component": "typescript-sdk",
      "package-name": "lelu-agent-auth",
      "changelog-path": "CHANGELOG.md",
      "release-type": "node"
    },
    "sdk/go": {
      "component": "go-sdk",
      "package-name": "lelu-go-sdk",
      "changelog-path": "CHANGELOG.md",
      "release-type": "go"
    },
    "sdk/python": {
      "component": "python-sdk",
      "package-name": "lelu-agent-auth-sdk",
      "changelog-path": "CHANGELOG.md",
      "release-type": "python"
    },
    "sdk/mcp": {
      "component": "lelu-mcp",
      "package-name": "lelu-mcp",
      "changelog-path": "CHANGELOG.md",
      "release-type": "node",
      "extra-files": [
        { "type": "json", "path": "server.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server.json", "jsonpath": "$.packages[0].version" }
      ]
    }
  },
  "release-type": "simple",
  "pull-request-title-pattern": "release${scope}: ${component} ${version}",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "docs", "section": "Documentation" },
    { "type": "chore", "section": "Miscellaneous", "hidden": false }
  ]
}
