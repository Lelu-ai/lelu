{
  "info": {
    "name": "Lelu Engine Demo",
    "description": "Demo of the Lelu authorization engine (zero-config local mode).\n\nSetup:\n1. Start the engine (see README / demo script) so it listens on http://localhost:8082\n2. Set the collection variable `apiKey` to the contents of ~/.lelu/engine.key\n3. Run the requests top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "apiKey", "value": "" },
    { "key": "tokenId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/healthz"
      }
    },
    {
      "name": "2. Agent Authorize — ALLOWED (read)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/agent/authorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"invoice_bot\",\n  \"action\": \"read_invoices\",\n  \"resource\": { \"id\": \"invoice:42\" },\n  \"confidence\": 0.95\n}"
        }
      }
    },
    {
      "name": "3. Agent Authorize — DENIED (delete, 99% confidence)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/agent/authorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"invoice_bot\",\n  \"action\": \"delete_records\",\n  \"resource\": { \"id\": \"invoice:42\" },\n  \"confidence\": 0.99\n}"
        }
      }
    },
    {
      "name": "4. Agent Authorize — HUMAN REVIEW (payment)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/agent/authorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"fin_bot\",\n  \"action\": \"make_payment\",\n  \"resource\": { \"id\": \"acct:7\" },\n  \"confidence\": 0.9\n}"
        }
      }
    },
    {
      "name": "5. Agent Authorize — DEFAULT DENY (unknown action)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/agent/authorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor\": \"deploy_bot\",\n  \"action\": \"deploy_app\",\n  \"confidence\": 0.9\n}"
        }
      }
    },
    {
      "name": "6. Human Authorize — alice reads invoice",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/authorize",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"alice\",\n  \"action\": \"read_invoices\",\n  \"resource\": { \"id\": \"invoice:42\" }\n}"
        }
      }
    },
    {
      "name": "7. Mint Token (5 min, read:invoices)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('tokenId', data.token_id);",
              "pm.test('token minted', () => pm.expect(data.token_id).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/v1/tokens/mint",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scope\": \"read:invoices\",\n  \"acting_for\": \"alice\",\n  \"ttl_seconds\": 300\n}"
        }
      }
    },
    {
      "name": "8. Revoke Token (uses tokenId from mint)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/v1/tokens/{{tokenId}}"
      }
    }
  ]
}
