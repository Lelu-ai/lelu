{
  "version": "1.0",
  "destructive_commands": [
    {
      "name": "recursive-force-delete",
      "command": "rm",
      "require_flags": [
        "r",
        "f"
      ],
      "long_flags": [
        "recursive",
        "force"
      ],
      "severity": "deny_if_protected"
    },
    {
      "name": "force-push",
      "command": "git",
      "subcommand": "push",
      "require_any_flag": [
        "f"
      ],
      "long_flags": [
        "force"
      ],
      "severity": "ask"
    },
    {
      "name": "force-push-with-lease",
      "command": "git",
      "subcommand": "push",
      "long_flags": [
        "force-with-lease"
      ],
      "severity": "ask"
    }
  ],
  "protected_paths": [
    {
      "exact": "$HOME"
    },
    {
      "exact": "/"
    },
    {
      "name": ".env"
    },
    {
      "name": ".env.*",
      "except": [
        ".env.example",
        ".env.sample",
        ".env.template",
        ".env.dist"
      ]
    },
    {
      "name": ".envrc"
    },
    {
      "name": ".git"
    },
    {
      "name": ".ssh"
    },
    {
      "name": "id_rsa*"
    },
    {
      "name": "id_ed25519*"
    },
    {
      "name": ".aws/credentials"
    }
  ],
  "sensitive_paths": [
    {
      "name": ".ssh"
    },
    {
      "name": "id_rsa*"
    },
    {
      "name": "id_ed25519*"
    },
    {
      "name": "id_ecdsa*"
    },
    {
      "name": ".aws/credentials"
    },
    {
      "name": ".aws/config"
    },
    {
      "name": ".netrc"
    },
    {
      "name": ".git-credentials"
    },
    {
      "name": ".docker/config.json"
    },
    {
      "name": ".kube/config"
    },
    {
      "name": ".gnupg"
    },
    {
      "name": ".env"
    },
    {
      "name": ".env.*",
      "except": [
        ".env.example",
        ".env.sample",
        ".env.template",
        ".env.dist"
      ]
    },
    {
      "name": ".envrc"
    }
  ],
  "guarded_paths": [
    {
      "under": "$HOME/.lelu"
    },
    {
      "name": ".claude/plugins"
    },
    {
      "name": ".claude/settings.json"
    },
    {
      "name": ".claude/settings.local.json"
    }
  ],
  "remote_script_pipe": {
    "enabled": true,
    "downloaders": [
      "curl",
      "wget",
      "fetch"
    ],
    "interpreters": [
      "sh",
      "bash",
      "zsh",
      "dash",
      "ksh",
      "fish",
      "python",
      "python3",
      "perl",
      "ruby",
      "node"
    ]
  },
  "tools": {
    "allow": [
      "LS",
      "NotebookRead",
      "WebSearch",
      "TodoRead",
      "TodoWrite",
      "Task",
      "Agent",
      "TaskOutput",
      "TaskStop",
      "BashOutput",
      "KillShell",
      "KillBash",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "Skill",
      "SlashCommand",
      "ToolSearch",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "SendMessage",
      "ListAgents",
      "CronList",
      "LSP"
    ],
    "web_fetch_allowed_hosts": [
      "github.com",
      "raw.githubusercontent.com",
      "docs.github.com",
      "developer.mozilla.org",
      "go.dev",
      "pkg.go.dev",
      "docs.python.org",
      "pypi.org",
      "npmjs.com",
      "docs.rs",
      "crates.io",
      "code.claude.com",
      "docs.claude.com"
    ]
  },
  "loop_detection": {
    "enabled": true,
    "repeat_threshold": 5,
    "window_seconds": 300
  },
  "session_budget": {
    "enabled": true,
    "max_duration_seconds": 14400
  }
}
